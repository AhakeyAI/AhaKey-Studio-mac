    "text.344fda8b5178": {
      "comment": "1: frame count; 2: starting device slot index (an identifier, not a count). Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已上传 %lld 帧到设备，槽位起点 %lld；切换模式时会先显示描述，再回到当前模式动图。"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Uploaded %1$lld frame starting at slot %2$lld. Mode switches show descriptions briefly before the animation."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Uploaded %1$lld frames starting at slot %2$lld. Mode switches show descriptions briefly before the animation."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
