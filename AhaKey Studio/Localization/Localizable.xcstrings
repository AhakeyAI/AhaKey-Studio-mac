    "text.c1438eaf9aa5": {
      "comment": "AgentManager — 尚无记录。触发 Codex 后应在此追加 JSON 行。若终端 Codex 有记录、Codex 客户端没有记录，说明客户端未加载当前 `~/.codex/config.toml` hook，通常需要重启 Codex 客户端/新开终端后再测。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无记录。触发 Codex 后应在此追加 JSON 行。若终端 Codex 有记录、Codex 客户端没有记录，说明客户端未加载当前 `~/.codex/config.toml` hook，通常需要重启 Codex 客户端/新开终端后再测。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records yet. Trigger Codex to append JSON lines. If terminal Codex logs appear but desktop logs do not, the desktop app has not loaded the current ~/.codex/config.toml hooks. Restart it or open a new terminal and retry."
          }
        }
      }
    },
