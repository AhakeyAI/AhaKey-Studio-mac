                      "state": "translated",
                      "value": "Writing lighting and key configuration (about %lld command)…"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Writing lighting and key configuration (about %lld commands)…"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
