    "text.de06847f9fd8": {
      "comment": "AgentManager — 本 App 连接蓝牙，用于配置与同步。Agent 的 LaunchJob 在持有方为 App 时不会加载，避免抢连接。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 连接蓝牙，用于配置与同步。Agent 的 LaunchJob 在持有方为 App 时不会加载，避免抢连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app owns Bluetooth for configuration and sync. The Agent LaunchJob stays unloaded while the app owns the connection."
          }
        }
      }
    },
