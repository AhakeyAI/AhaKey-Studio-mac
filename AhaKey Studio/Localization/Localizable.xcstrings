    "text.fd48629cd315": {
      "comment": "AhaKeyStudioView — 开启后，macOS 原生语音转写完成后会先请求云端整理，再粘贴整理后的文本。未登录、过期或网络失败时会自动回退原始转写。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，macOS 原生语音转写完成后会先请求云端整理，再粘贴整理后的文本。未登录、过期或网络失败时会自动回退原始转写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After macOS transcription, AhaType refines the text in the cloud before pasting. If signed out, expired or offline, the original transcription is used instead."
          }
        }
      }
    },
