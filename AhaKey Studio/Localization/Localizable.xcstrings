    "text.670773423831": {
      "comment": "AhaKeyStudioModels — 若需与「⌘↵ 接受 / ⌘⌫ 拒绝」等组合键一致，请在编辑器里为对应键加修饰，并在 Cursor 设置 → Keyboard Shortcuts 中绑成相同组合。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若需与「⌘↵ 接受 / ⌘⌫ 拒绝」等组合键一致，请在编辑器里为对应键加修饰，并在 Cursor 设置 → Keyboard Shortcuts 中绑成相同组合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use shortcuts such as ⌘↵ to accept or ⌘⌫ to reject, add modifiers in the editor and assign the same shortcuts in Cursor Settings → Keyboard Shortcuts."
          }
        }
      }
    },
