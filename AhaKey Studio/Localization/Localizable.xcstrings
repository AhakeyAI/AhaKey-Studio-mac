    "text.2af44c9e0fc4": {
      "comment": "1: required frame count; 2: approximate total device frame capacity. Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "动画需要 %lld 帧，但设备当前没有足够连续空间。总容量上限约为 %lld 帧。"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "The animation needs %1$lld frame, but the device lacks contiguous space. Total frame capacity: approximately %2$lld."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "The animation needs %1$lld frames, but the device lacks contiguous space. Total frame capacity: approximately %2$lld."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "text.2af8cd09a077": {
      "comment": "UnifiedAhaKeyOnboardingView — 已授权，但系统蓝牙当前关闭，请在控制中心或系统设置中打开。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权，但系统蓝牙当前关闭，请在控制中心或系统设置中打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is granted, but Bluetooth is off. Turn it on in Control Center or System Settings."
          }
        }
      }
    },
    "text.2b9074c1614f": {
      "comment": "AhaKeyStudioView — 当前是旧协议固件，0x91 会假返回成功但不改灯；请先刷新固件。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前是旧协议固件，0x91 会假返回成功但不改灯；请先刷新固件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This firmware uses the old protocol: 0x91 returns a false success without changing the lights. Update the firmware first."
          }
        }
      }
    },
    "text.2ba5ce328314": {
      "comment": "AgentManager — 在 %@ 中未发现 AhaKey Codex hook 标记块。",
      "extractionState": "manual",
      "localizations": {
