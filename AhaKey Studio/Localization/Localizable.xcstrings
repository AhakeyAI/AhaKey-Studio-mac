    "text.00430b9bc441": {
      "comment": "AgentManager — 在 %@ 中**未发现**包含 `ahakeyconfig-agent` 或 `ahakey-state` 的 `command`。\n\n若 Hook 在**项目级** `.cursor/hooks.json`，请在该仓库内手动删除；本按钮只改用户级 `~/.cursor/hooks.json`。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中**未发现**包含 `ahakeyconfig-agent` 或 `ahakey-state` 的 `command`。\n\n若 Hook 在**项目级** `.cursor/hooks.json`，请在该仓库内手动删除；本按钮只改用户级 `~/.cursor/hooks.json`。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No command containing ahakeyconfig-agent or ahakey-state found in %@.\n\nIf hooks are in a project's .cursor/hooks.json, remove them there. This button only updates ~/.cursor/hooks.json."
          }
        }
      }
    },
