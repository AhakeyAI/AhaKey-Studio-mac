    "text.0cc0a6dc8d4e": {
      "comment": "1: uploaded frame count in a compact label. Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 帧"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld frame"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld frames"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "text.0cec48e9e1d7": {
      "comment": "AhaKeyStudioModels — 带拖尾的单向扫过，像彗星。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
