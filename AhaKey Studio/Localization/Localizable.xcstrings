          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates cli-config (CLI) and terminalAllowlist in permissions.json (the Agent TUI “Not in allowlist” layer). See their respective documentation. Both files are backed up as .ahakey.bak first."
          }
        }
      }
    },
