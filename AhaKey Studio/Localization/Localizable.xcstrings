          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Siri, Dictation and Accessibility in order, then Input Monitoring. Input Monitoring usually requires quitting and reopening the app. Your setup progress is saved."
          }
        }
      }
    },
