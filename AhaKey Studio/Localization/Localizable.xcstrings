{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "device.hooks.title": {
      "comment": "Integration badge. Argument 1 is a CLI product name (e.g. Cursor). Hooks means integration callbacks. Translate/reorder the full phrase as needed.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hooks"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hooks"
          }
        }
      }
    },
    "device.lighting.off": {
      "comment": "Light is switched off. This is a state, not a button to close a window. Japanese: オフ/消灯, not 閉じる.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "device.mode.summary": {
      "comment": "Current device mode. Argument 1: localized mode title; argument 2: product/default mode name. May reorder using %2$@ and %1$@.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        }
      }
    },
    "device.mode.unknown": {
