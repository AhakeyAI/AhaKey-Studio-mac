    "text.6b19394efdb4": {
      "comment": "AhaKeyStudioView — Mode 1 / Mode 2 时，固件的 update_claude_ws2812() 直接 return，**灯条不再随 IDE state 变**，会停在上一次设定的颜色上。这是固件设计，不是 bug。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode 1 / Mode 2 时，固件的 update_claude_ws2812() 直接 return，**灯条不再随 IDE state 变**，会停在上一次设定的颜色上。这是固件设计，不是 bug。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In firmware Mode 1 / Mode 2, update_claude_ws2812() returns immediately. IDE state no longer changes the light bar, which retains its last color. This is firmware behavior."
          }
        }
      }
    },
