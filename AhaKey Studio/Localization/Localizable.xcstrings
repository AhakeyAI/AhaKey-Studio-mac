    "text.bdd1bbea1698": {
      "comment": "AgentManager — 尚无记录。在 Claude 中触发 PermissionRequest，在 Cursor 中让 Agent 调工具/Shell/MCP，或在 Kimi Code CLI 中触发工具调用后，会在此追加带 `ide` / `hookEvent` 的 JSON 行。若始终为空，请确认已安装 Agent、Hooks、蓝牙由 Agent 占用，且 `~/Library/.../AhaKeyConfig/diagnostics/` 可写。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无记录。在 Claude 中触发 PermissionRequest，在 Cursor 中让 Agent 调工具/Shell/MCP，或在 Kimi Code CLI 中触发工具调用后，会在此追加带 `ide` / `hookEvent` 的 JSON 行。若始终为空，请确认已安装 Agent、Hooks、蓝牙由 Agent 占用，且 `~/Library/.../AhaKeyConfig/diagnostics/` 可写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records yet. Trigger Claude PermissionRequest, a Cursor tool/Shell/MCP call or a Kimi tool call to append JSON lines with ide / hookEvent fields. If empty, check Agent and hook installation, Agent Bluetooth ownership and write access to ~/Library/.../AhaKeyConfig/diagnostics/."
          }
        }
      }
    },
