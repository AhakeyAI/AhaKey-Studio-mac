    "text.e585313ab4e1": {
      "comment": "1: number of uploaded LCD animations; 2: estimated command count. Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已上传 %lld 个 LCD 动图，正在写入灯效与键位配置（约 %lld 条）…"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Uploaded %1$lld LCD animation. Writing lighting and key configuration (approximate command count: %2$lld)…"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Uploaded %1$lld LCD animations. Writing lighting and key configuration (approximate command count: %2$lld)…"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
