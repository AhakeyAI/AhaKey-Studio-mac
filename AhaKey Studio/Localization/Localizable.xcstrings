    "text.1386c39d0d21": {
      "comment": "AhaKeyStudioView — 连接超时，本次未写入键盘；已释放蓝牙给 Agent，可再次进入编辑后重试保存。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时，本次未写入键盘；已释放蓝牙给 Agent，可再次进入编辑后重试保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection timed out. Nothing was written; Bluetooth has been returned to the Agent. Enter editing again to retry saving."
