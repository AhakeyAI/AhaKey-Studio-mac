    "text.3139cb04466d": {
      "comment": "AgentManager — 请点「查看日志」检查 %@；并确认系统「隐私与安全性」中已允许本应用使用蓝牙；若通过 LaunchAgent 拉起 agent 子进程，也需为同一签名的二进制授权。",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请点「查看日志」检查 %@；并确认系统「隐私与安全性」中已允许本应用使用蓝牙；若通过 LaunchAgent 拉起 agent 子进程，也需为同一签名的二进制授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select View Logs to inspect %@. Allow Bluetooth for this app in Privacy & Security. An Agent launched through LaunchAgent also needs permission for its signed binary."
          }
        }
      }
    },
