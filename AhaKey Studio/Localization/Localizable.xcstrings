    "text.debf58659f92": {
      "comment": "1: number of frames in the default animation. Plural selection uses argument 1 (Int). Translate the full sentence; positional placeholders may reorder arguments.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已自动同步默认动图（%lld 帧）。"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Default animation synced automatically (%lld frame)."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Default animation synced automatically (%lld frames)."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
