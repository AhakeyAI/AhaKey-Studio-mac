    "text.b54c66c478fe": {
      "comment": "1: actual frame count; 2: per-mode frame limit. Plural selection uses argument 1 (Int).",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "当前动图共有 %lld 帧，超过单模式上限 %lld 帧。请减少帧数或缩短动图后再试。"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "This animation has %1$lld frame, exceeding the per-mode limit of %2$lld. Reduce the frame count or animation length and try again."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "This animation has %1$lld frames, exceeding the per-mode limit of %2$lld. Reduce the frame count or animation length and try again."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "text.b5de2782e509": {
      "comment": "FirmwareFlasherView — App 内置版本",
