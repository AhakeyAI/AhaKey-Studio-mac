{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey 配置需要蓝牙连接你的 AhaKey 键盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studio uses Bluetooth to connect to your AhaKey keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studioは、AhaKeyキーボードに接続するためにBluetoothを使用します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studio 需要访问麦克风，才能使用苹果原生语音转写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studio uses the microphone to transcribe your speech with Apple speech recognition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studioは、Appleの音声認識で音声を文字起こしするためにマイクを使用します。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studio 需要语音识别权限，才能把语音键转换成苹果原生转写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studio uses speech recognition to transcribe speech triggered by the voice key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AhaKey Studioは、音声キーで開始した音声を文字起こしするために音声認識を使用します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
