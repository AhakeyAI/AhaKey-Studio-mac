    "voiceNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edits the key configuration only. Voice capture and text insertion are not running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅编辑按键配置，尚未启动语音监听或输入注入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー設定のみを編集します。音声認識やテキスト入力は実行していません。"
          }
        }
      }
    },
    "globalBrightness": {
