      }
    },
    "OPERATION_NOT_FOUND": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was not found. Its device result remains unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到历史操作，设备结果仍未知。"
