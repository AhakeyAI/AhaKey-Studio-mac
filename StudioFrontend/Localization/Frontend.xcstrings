    "oledNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation stays in your local draft. Resource upload is not connected yet; saving configuration does not upload images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动图仅保存在本地草稿；资源上传尚未接入，保存配置不会写入图片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションはローカルの下書きにのみ保存されます。リソースアップロードは未接続のため、設定保存では画像を書き込みません。"
          }
        }
      }
    },
