    "loseResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lose the next acceptance response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次保存丢失受理响应"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の受付応答を破棄"
          }
        }
      }
    },
    "loseConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate IPC disconnection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟 IPC 断线"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPC 切断を再現"
          }
        }
      }
    },
    "leverNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lever state comes from Runtime. Software override is not available in this version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨杆状态由 Runtime 提供；此版本不提供软件覆盖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レバーの状態は Runtime から取得します。この版ではソフトウェアによる上書きは利用できません。"
          }
        }
      }
    },
    "servicesNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook management, voice and firmware flashing will be enabled when their Runtime features are connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook 管理、语音和刷机将在对应 Runtime 功能接入后开放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook 管理・音声・ファームウェア更新は、Runtime の対応機能との接続後に利用できます。"
          }
        }
      }
    },
