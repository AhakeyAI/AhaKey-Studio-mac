          }
        }
      }
    },
    "OPERATION_FAILED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation did not complete. Check the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成，请重新核对设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が完了しませんでした。デバイスを確認してください。"
          }
        }
      }
    },
    "RPC_ERROR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Runtime request failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 请求失败。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime への要求が失敗しました。"
          }
        }
      }
    },
    "PERMISSION_DENIED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime denied access. Check the connection credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 拒绝访问，请检查连接凭据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime がアクセスを拒否しました。接続情報を確認してください。"
          }
        }
      }
    },
    "GIF_IMPORT_FAILED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not import the GIF. Check that it is valid and no larger than 2 MiB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入 GIF；请确认文件有效且不超过 2 MiB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF を読み込めません。有効なファイルで、2 MiB 以下か確認してください。"
          }
        }
      }
    },
    "DRAFT_SAVE_FAILED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the local draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地草稿保存失败。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの下書きを保存できません。"
          }
        }
      }
    },
    "PENDING_SAVE_FAILED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not persist operation tracking information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存操作跟踪信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作の追跡情報を保存できません。"
          }
        }
      }
    },
    "unknownBaseline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete configuration baseline is unavailable. Your draft is kept locally; saving is disabled until the baseline is reloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得完整配置基线。草稿保存在本地，重新读取基线后才能保存到后台。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な設定の基準を取得できていません。下書きはローカルに保持されます。基準を再取得するまで保存できません。"
          }
        }
      }
    }
