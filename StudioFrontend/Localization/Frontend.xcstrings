{
  "sourceLanguage": "en",
  "strings": {
    "mockNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode: operations only change simulated state. No real keyboard is connected or written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式：操作只改变模拟状态，不会连接或写入真实键盘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモモード：操作はシミュレーションのみです。実際のキーボードには接続・書き込みしません。"
          }
        }
      }
    },
    "offlineNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime is offline. You can keep editing your local draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime 尚未连接，可以继续编辑本地草稿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime は未接続です。ローカルの下書きは引き続き編集できます。"
          }
        }
      }
    },
    "editingMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑模式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集モード"
          }
        }
      }
    },
    "canvasNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas shows your draft. Tabs switch the mode being edited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布展示当前草稿；切换标签只切换编辑模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスは下書きを表示します。タブは編集対象のみを切り替えます。"
          }
        }
      }
    },
    "deviceMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current keyboard mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘当前模式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの現在のモード"
          }
        }
      }
    },
    "unknownTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device result unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备执行结果未知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの実行結果が不明です"
          }
        }
      }
    },
    "checkedDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device checked, stop tracking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对设备，结束跟踪"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを確認済み・追跡を終了"
          }
        }
      }
    },
    "cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "unknownBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend cannot find this operation. Check the keyboard before writing again. Stopping tracking neither cancels nor resends it; reload the baseline before another save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台找不到这次操作。请先核对键盘，避免重复写入。结束跟踪不会取消或重发操作，之后必须重新读取基线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドにこの操作がありません。再書き込みの前にキーボードを確認してください。追跡の終了では操作の取消や再送は行いません。保存前に基準を再取得してください。"
          }
        }
      }
    },
    "rebaseTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload configuration baseline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取设备配置基线"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の基準を再取得"
          }
        }
      }
    },
    "keepDraft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep draft and reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留草稿并重新读取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを保持して再取得"
          }
        }
      }
    },
    "rebaseBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your edits and use the latest backend configuration as the next save baseline. Saving will overwrite the selected scope with your draft; check which changes you want to keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留当前编辑，重新读取后台配置作为下次保存的基线。保存时会用当前草稿覆盖选中范围，请先确认希望保留的修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集内容を保持し、最新の設定を次回保存の基準にします。保存時には選択範囲を下書きで上書きするため、残したい変更を確認してください。"
          }
        }
      }
    },
    "noDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No keyboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接键盘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード未接続"
          }
        }
      }
    },
